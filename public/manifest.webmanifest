  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Notícias", "short_name": "Notícias", "url": "/noticias", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "No ar hoje", "short_name": "No ar", "url": "/animes/calendario", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Otaku TV", "short_name": "Otaku TV", "url": "/otaku-tv", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Quiz", "short_name": "Quiz", "url": "/quiz", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
