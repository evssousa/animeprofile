# Copie para .env (o .env nunca vai para o Git). Na Hostinger, cadastre as mesmas variáveis no painel
# do app Node.js. Lista completa e para que serve cada uma: docs/arquitetura.md.

# URL pública do site (canonical, Open Graph, sitemap). Usada no build.
VITE_SITE_URL=http://localhost:5173

# 1 no endereço de teste (novo.animeprofile.com.br): nada entra no Google.
SITE_NOINDEX=1

# MySQL. Na Hostinger: host 127.0.0.1 (nunca o srvNNNN.hstgr.io).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Protege /api/cron/* (mínimo 24 caracteres).
CRON_TOKEN=

# Pasta dos arquivos enviados (padrão: ~/animeprofile-media)
# MEDIA_DIR=
